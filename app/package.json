    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
