{
  "name": "geocollar-app",
  "version": "0.1.0",
  "description": "GeoCollar companion app: find a collar over Bluetooth, see the dog on a map, silence the lost alert.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
