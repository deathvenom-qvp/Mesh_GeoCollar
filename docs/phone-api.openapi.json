          "beacon_silenced": {
            "default": false,
            "title": "Beacon Silenced",
            "type": "boolean"
          },
          "no_fix": {
            "default": false,
            "title": "No Fix",
            "type": "boolean"
          },
          "home": {
            "default": false,
            "title": "Home",
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "lat",
          "lon"
        ],
        "title": "CollarStatus",
        "type": "object"
      },
      "PhonePosition": {
        "properties": {
          "lat": {
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          },
          "accuracy_m": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Accuracy M"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "PhonePosition",
        "type": "object"
      },
      "RelayRequest": {
        "description": "A collar's report the phone got over Bluetooth, for a collar the base has not heard from\nover the mesh lately.",
        "properties": {
          "node_id": {
            "pattern": "^![0-9a-f]{8}$",
            "title": "Node Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CollarStatus"
          },
          "fix_age_s": {
            "anyOf": [
              {
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Age of the collar's GPS fix when it answered, if it has had one",
            "title": "Fix Age S"
          },
          "age_ms": {
            "default": 0,
            "description": "How long ago the phone got it",
            "minimum": 0,
            "title": "Age Ms",
            "type": "integer"
          },
          "phone_position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PhonePosition"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Where the phone was: within Bluetooth range of the dog"
          }
        },
        "required": [
          "node_id",
          "status"
        ],
        "title": "RelayRequest",
        "type": "object"
      },
      "RelayReply": {
        "properties": {
          "recorded": {
            "title": "Recorded",
            "type": "boolean"
          },
          "reason": {
            "enum": [
              "recorded",
              "heard_over_mesh",
              "too_soon",
              "too_old",
              "unknown_collar"
            ],
            "title": "Reason",
            "type": "string"
          },
          "next_s": {
            "description": "Offer the next report after this many seconds",
            "title": "Next S",
            "type": "integer"
          }
        },
        "required": [
          "recorded",
          "reason",
          "next_s"
        ],
        "title": "RelayReply",
        "type": "object"
      }
    }
  }
}
